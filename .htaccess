# Dashboard KITO di Hostinger (inbranch.region2.co.id)
# Manifest PWA harus disajikan dengan tipe yang benar agar Chrome, PWABuilder, dan APK TWA mengenalinya.
AddType application/manifest+json .webmanifest
AddType application/json .json
# file verifikasi aplikasi Android (TWA): /.well-known/assetlinks.json
<IfModule mod_headers.c>
  <FilesMatch "assetlinks\.json$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  # service worker & konfigurasi selalu diperiksa ulang agar pembaruan cepat sampai
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------- Keamanan ----------
# daftar isi folder tidak ditampilkan
Options -Indexes

# berkas internal (skrip olah data, sumber APK, riwayat git, catatan) tidak boleh diunduh dari situs
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.git(/|$) - [F,L]
  RewriteRule ^tools(/|$) - [F,L]
</IfModule>
<FilesMatch "(^\.|\.(py|pyc|md|cjs|kt|kts|gradle|jks|keystore|sh|bak|old|orig|swp|sql|sqlite|db|log|ini|env|xlsx|xlsb|xls|xltx|csv|zip)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# header keamanan browser (berlaku juga untuk push-php/)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://inbranch.region2.co.id https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self'; manifest-src 'self'; frame-src 'none'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
  Header unset X-Powered-By
  # data operasional & halaman backend tidak disimpan di cache bersama (proxy kantor dsb.)
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, private"
  </FilesMatch>
</IfModule>
