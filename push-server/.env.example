# Salin ke .env lalu isi. Buat kunci dengan: npm run vapid
PORT=8080
VAPID_PUBLIC_KEY=BCbInxdmPkofmOl81c40EXmDQI4X40_jX07CdNrv7rDgvz90vXdz8iiF9QPbJWGm278rVHhRc0mbtkOyzVPKCjM
VAPID_PRIVATE_KEY=94fWE6YL1duoZfbZC68cZvs84zunRIUKjxtodQOSa2I
# kontak pengelola (wajib menurut standar VAPID): mailto:email atau https://url
VAPID_SUBJECT=mailto:admin@example.com
# token untuk API admin & halaman /admin (minimal 24 karakter acak)
ADMIN_TOKEN=mgIeQwzOymFS-FtTpFzauGyBuE-84MCCDRZZ_lkhO9I
# origin dashboard yang boleh berlangganan (pisahkan koma), mis. https://zexvron.github.io
ALLOWED_ORIGINS=https://zexvron.github.io
# lokasi database SQLite
DB_PATH=./data/push.db
# isi 1 bila server di belakang reverse proxy (Nginx/Caddy) agar IP klien terbaca benar
TRUST_PROXY=1
# ikon & tautan default notifikasi (URL lengkap dashboard)
DEFAULT_ICON=https://zexvron.github.io/dashboard-kito/assets/images/ios/icon-192.png
DEFAULT_URL=https://zexvron.github.io/dashboard-kito/
