{
  "name": "kito-push-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend push notification KITO (Web Push/VAPID) untuk website, desktop, Android, dan iOS. Tanpa dependensi luar.",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "vapid": "node scripts/generate-vapid.js",
    "send": "node scripts/send.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "cek": "node --disable-warning=ExperimentalWarning scripts/cek.js"
  },
  "license": "UNLICENSED"
}
